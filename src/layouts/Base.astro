---
import '@/index.css'
import HeaderIsland from '@/islands/HeaderIsland'
import { StaticFooter } from '@/islands/StaticPages'
import { renderHeadTags, type PageSeo } from '@/lib/seo'
import { serializeMessages } from '@/lib/messages'
import { ADSENSE_CLIENT } from '@/lib/ads'

interface Props {
  seo: PageSeo
  /** The page's own URL with its locale prefix, e.g. "/es/red-screen/". */
  url: string
  /** The page shows an interactive tool, so it needs the tool text dictionary. */
  hasTool?: boolean
}

const { seo, url, hasTool = false } = Astro.props
const htmlLang = seo.lang === 'pt-br' ? 'pt-BR' : seo.lang
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <Fragment set:html={renderHeadTags(seo)} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- This page's interface strings; the browser bundle carries no dictionaries of its own. -->
    <script is:inline type="application/json" id="ws-messages" set:html={serializeMessages(seo.lang, hasTool)} />
    <script is:inline>
      // Apply the saved theme (or the system one) before first paint, so dark mode never flashes white.
      (function () {
        try {
          var saved = localStorage.getItem('whitescreen_theme')
          var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches
          if (dark) {
            document.documentElement.classList.add('dark')
            document.querySelector('meta[name="theme-color"]').setAttribute('content', '#1b1d22')
          }
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <div class="flex min-h-screen flex-col bg-background text-foreground">
      <HeaderIsland url={url} client:load />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <StaticFooter url={url} />
    </div>
    {
      ADSENSE_CLIENT && !seo.notFound && (
        <script is:inline define:vars={{ client: ADSENSE_CLIENT }}>
          // AdSense loads only after the first scroll, tap or key press (or 4 s idle), so ads never
          // compete with the tool for the first paint. Units already have their space reserved.
          ;(function () {
            var started = false
            function start() {
              if (started || !document.querySelector('ins.adsbygoogle')) return
              started = true
              var script = document.createElement('script')
              script.async = true
              script.crossOrigin = 'anonymous'
              script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client
              document.head.appendChild(script)
              // Only units shown at this screen width get an ad. AdSense fills the first unfilled
              // ins.adsbygoogle in page order, so hidden ones (the desktop rail on a phone) drop the class.
              document.querySelectorAll('ins.adsbygoogle').forEach(function (ins) {
                if (!ins.offsetWidth) ins.classList.remove('adsbygoogle')
              })
              document.querySelectorAll('ins.adsbygoogle').forEach(function () {
                ;(window.adsbygoogle = window.adsbygoogle || []).push({})
              })
            }
            ;['scroll', 'pointerdown', 'keydown'].forEach(function (type) {
              addEventListener(type, start, { once: true, passive: true })
            })
            setTimeout(start, 4000)
          })()
        </script>
      )
    }
  </body>
</html>
